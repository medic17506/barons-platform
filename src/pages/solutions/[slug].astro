---
import Layout from '../../layouts/Layout.astro';
import AuthorityPage from '../../components/authority/AuthorityPage.astro';
import { authoritySolutions } from '../../data/authority/solutions';

export function getStaticPaths() {
  return authoritySolutions
    .filter((solution) => solution.status === 'published')
    .map((solution) => ({
      params: { slug: solution.slug },
      props: { solution },
    }));
}

const { solution } = Astro.props;
---

<Layout title={solution.seoTitle} description={solution.seoDescription} canonical={`/solutions/${solution.slug}`}>
  <main id="main-content">
    <AuthorityPage entity={solution} />
  </main>
</Layout>
