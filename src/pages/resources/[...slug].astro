---
import { getCollection, render } from 'astro:content';
import ResourceLayout from '../../layouts/ResourceLayout.astro';

export async function getStaticPaths() {
  const resources = await getCollection('resources', ({ data }) => !data.draft && data.status === 'published');

  return resources.map((resource) => ({
    params: { slug: resource.id },
    props: { resource },
  }));
}

const { resource } = Astro.props;
const { Content, headings } = await render(resource);
const canonical = `/resources/${resource.id}/`;
---

<ResourceLayout data={resource.data} canonical={canonical} headings={headings}>
  <Content />
</ResourceLayout>
