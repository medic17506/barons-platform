---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import ContactForm from '../../components/forms/ContactForm.astro';
---

<Layout title="Contact Barons | Barons, Inc." description="Contact Barons for new business, client support, billing, partnerships, vendors, ASG inquiries, speaking, media, careers, or general questions.">
  <main id="main-content">
    <PageHero
      eyebrow="Contact"
      title="Start with the business problem."
      description="Tell us what is messy, stuck, growing, breaking, or about to change. We will route your message to the right person and help you identify the next step."
    />

    <section class="mx-auto grid max-w-7xl gap-8 px-6 py-20 lg:grid-cols-[0.72fr_1.28fr] lg:items-start">
      <aside class="rounded-3xl border border-white/10 bg-white/[0.03] p-7">
        <p class="text-sm font-black uppercase tracking-[0.22em] text-green-300">What happens next</p>
        <h2 class="mt-3 text-3xl font-black text-white">A real person reviews your message.</h2>
        <p class="mt-4 leading-7 text-slate-300">The reason you select determines who receives the inquiry. New business and client support go to Dakota, billing goes to Sharon, ASG interest goes to Kylee, and partnership, vendor, speaking, media, general, and career inquiries go to Brandon.</p>
        <p class="mt-4 leading-7 text-slate-300">We will ask follow-up questions only when needed and help move the request into the right conversation, support process, or next step.</p>
      </aside>

      <ContactForm />
    </section>
  </main>
</Layout>
