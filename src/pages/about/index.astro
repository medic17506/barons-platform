---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/sections/PageHero.astro';
---
<Layout title="About | Barons, Inc." description="Barons is a human-first business systems company helping organizations build technology that supports real growth.">
  <main id="main-content">
    <PageHero eyebrow="About Barons" title="We are not defined by the software we sell." description="We are defined by the problems we solve, the relationships we protect, and the systems we help businesses build with confidence." />
    <section class="mx-auto grid max-w-7xl gap-8 px-6 py-20 lg:grid-cols-3">
      {['Listen first', 'Recommend honestly', 'Support long-term'].map((title) => (
        <article class="rounded-3xl border border-white/10 bg-white/[0.03] p-7">
          <h2 class="text-2xl font-black">{title}</h2>
          <p class="mt-4 leading-7 text-slate-400">Technology changes. Business challenges evolve. Relationships still matter. Every recommendation should serve the client’s future, not just the sale in front of us.</p>
        </article>
      ))}
    </section>
  </main>
</Layout>
