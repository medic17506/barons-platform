---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import TrustStrip from '../components/home/TrustStrip.astro';
import SolutionsGrid from '../components/home/SolutionsGrid.astro';
import BossFramework from '../components/home/BossFramework.astro';
import WhoWeHelp from '../components/home/WhoWeHelp.astro';
import ProcessSection from '../components/home/ProcessSection.astro';
import FranchiseSignal from '../components/home/FranchiseSignal.astro';
import HumanFirstCTA from '../components/home/HumanFirstCTA.astro';
---

<Layout
