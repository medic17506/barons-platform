---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/sections/PageHero.astro';
---

<Layout title="Franchise Business Systems & Support | Barons" description="Franchise-aware accounting, technology, reporting, and operational support from Barons.">
  <main id="main-content">
    <PageHero eyebrow="Who we help" title="Franchise systems need consistency without losing the humans." description="Barons helps franchise owners implement required technology correctly, understand corporate standards, and build practical operating systems around the realities of each location." />
    <section class="mx-auto max-w-7xl px-6 py-20">
      <div class="grid gap-6 md:grid-cols-2">
        <a href="/franchises/hotworx" class="rounded-[2rem] border border-white/10 bg-white/[0.03] p-8 transition hover:-translate-y-1 hover:border-green-300/40">
          <p class="text-sm font-black uppercase tracking-[0.22em] text-green-300">Flagship franchise resource</p>
          <h2 class="mt-4 text-3xl font-black text-white">HOTWORX</h2>
          <p class="mt-4 leading-8 text-slate-300">Verified QuickBooks Online Plus requirements, administrator standards, location naming, implementation guidance, and multi-unit support.</p>
          <p class="mt-6 font-bold text-green-300">Explore HOTWORX support →</p>
        </a>
        <div class="rounded-[2rem] border border-dashed border-white/15 p-8">
          <p class="text-sm font-black uppercase tracking-[0.22em] text-slate-500">More franchise systems</p>
          <h2 class="mt-4 text-3xl font-black text-white">Built from verified knowledge</h2>
          <p class="mt-4 leading-8 text-slate-300">Additional franchise pages will be published as Barons documents current requirements, implementation experience, and franchisor-reviewed standards.</p>
        </div>
      </div>
    </section>
  </main>
</Layout>
