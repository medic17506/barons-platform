---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import BrandLogo from '../../components/entities/BrandLogo.astro';
import { getBrandAsset } from '../../data/brandAssets';

const partnerGroups = [
  {
    title: 'Accounting & financial operations',
    description: 'Systems for accounting, financial control, reporting, accounts receivable, and multi-entity visibility.',
    partners: ['QuickBooks Online', 'QuickBooks Enterprise', 'Intuit Enterprise Suite', 'Xero', 'Zoho Books', 'Bill360'],
  },
  {
    title: 'Payroll & workforce',
    description: 'Technology supporting payroll, time, benefits, retirement, and employee administration.',
    partners: ['Gusto', 'Human Interest'],
  },
  {
    title: 'Payments, POS & cash flow',
    description: 'Tools that connect the sale, payment, deposit, customer experience, and accounting record.',
    partners: ['Clover', 'Bill360'],
  },
  {
    title: 'CRM & business operations',
    description: 'Platforms that organize customer relationships, sales activity, onboarding, and operational workflows.',
    partners: ['Zoho One', 'Zoho CRM'],
  },
  {
    title: 'Inventory, reporting & protection',
    description: 'Technology for inventory control, business intelligence, multi-entity reporting, backup, and security.',
    partners: ['Cin7', 'Lightspeed', 'Databox', 'Fathom', 'Qvinci', 'SysCloud', 'Avalara'],
  },
] as const;
---

<Layout title="Technology Partners | Barons, Inc." description="Explore the accounting, payroll, payment, POS, CRM, reporting, inventory, and automation technology partners Barons uses to build connected business systems.">
  <main id="main-content">
    <PageHero
      eyebrow="Technology Partners"
      title="Technology should support the system—not define it."
      description="We evaluate technology based on fit, information flow, implementation requirements, support, and the people who will use it. There is no universal best platform."
    />

    <section class="mx-auto max-w-7xl px-6 py-20">
      <div class="max-w-3xl">
        <p class="text-sm font-black uppercase tracking-[0.22em] text-green-300">The Barons approach</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight text-white sm:text-4xl">Business need first. Technology second.</h2>
        <p class="mt-5 text-lg leading-8 text-slate-300">We do not build a business around a vendor. We identify the operational problem, define the required information flow, and then select the technology that best supports the people and process.</p>
      </div>

      <div class="mt-14 space-y-14">
        {partnerGroups.map((group) => (
          <section aria-labelledby={`${group.title.toLowerCase().replaceAll(' ', '-')}-heading`}>
            <div class="max-w-3xl">
              <h2 id={`${group.title.toLowerCase().replaceAll(' ', '-')}-heading`} class="text-2xl font-black text-white">{group.title}</h2>
              <p class="mt-2 leading-7 text-slate-400">{group.description}</p>
            </div>

            <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {group.partners.map((partner) => {
                const brand = getBrandAsset(partner);
                const card = (
                  <article class="group h-full rounded-3xl border border-white/10 bg-white/[0.03] p-6 transition hover:-translate-y-1 hover:border-green-300/40 hover:bg-white/[0.05]">
                    <BrandLogo name={partner} size="md" />
                    {brand.businessSystems?.length && (
                      <p class="mt-4 text-sm leading-6 text-slate-400">Supports {brand.businessSystems.slice(0, 4).join(', ')}.</p>
                    )}
                    {brand.href && <span class="mt-5 inline-flex text-sm font-black text-green-300">Explore partner <span class="ml-2" aria-hidden="true">→</span></span>}
                  </article>
                );

                return brand.href ? (
                  <a href={brand.href} class="block rounded-3xl focus:outline-none focus-visible:ring-2 focus-visible:ring-green-300 focus-visible:ring-offset-4 focus-visible:ring-offset-slate-950">
                    {card}
                  </a>
                ) : card;
              })}
            </div>
          </section>
        ))}
      </div>
    </section>

    <section class="border-y border-white/10 bg-white/[0.03]">
      <div class="mx-auto grid max-w-7xl gap-8 px-6 py-16 lg:grid-cols-[1fr_auto] lg:items-center">
        <div class="max-w-3xl">
          <p class="text-sm font-black uppercase tracking-[0.22em] text-green-300">Need help choosing?</p>
          <h2 class="mt-3 text-3xl font-black text-white">This is a Strategy Session—not a sales call.</h2>
          <p class="mt-4 text-lg leading-8 text-slate-300">We will help you understand the options, explain the tradeoffs, and steer you toward the right product and price for your business—even when that means recommending something different from where the conversation started.</p>
        </div>
        <a href="/start" class="inline-flex min-h-12 items-center justify-center rounded-full bg-green-300 px-7 py-3 font-black text-slate-950 transition hover:bg-green-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-green-300 focus-visible:ring-offset-4 focus-visible:ring-offset-slate-950">Schedule a Strategy Session</a>
      </div>
    </section>
  </main>
</Layout>
