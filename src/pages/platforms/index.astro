---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import { platforms } from '../../data/solutions';
---
<Layout title="Platforms | Barons, Inc." description="Barons supports QuickBooks, Xero, Zoho One, Lightspeed, Cin7, Avalara, Bill360, Databox, Fathom, and more.">
  <main id="main-content">
    <PageHero eyebrow="Platforms" title="Vendor-aware, but never vendor-blind." description="There is no universal best platform. There is only the best fit for the business, team, requirements, budget, and growth path." />
    <section class="mx-auto max-w-7xl px-6 py-20">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {platforms.map((platform) => <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5 font-bold text-slate-200">{platform}</div>)}
      </div>
    </section>
  </main>
</Layout>
