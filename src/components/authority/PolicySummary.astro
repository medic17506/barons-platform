---
import type { FranchisePolicy } from '../../data/authority/policies';

interface Props {
  policy: FranchisePolicy;
}

const { policy } = Astro.props;
const statusLabels = {
  verified: 'Verified standard',
  observed: 'Observed in current implementations',
  'barons-best-practice': 'Barons best practice',
  'pending-verification': 'Pending franchisor verification',
  historical: 'Historical standard',
};
const roleLabels = {
  implements: 'Barons implements this standard',
  supports: 'Barons supports this standard',
  coordinates: 'Barons coordinates with the required provider',
  'not-involved': 'Outside Barons service scope',
};
---

<section aria-labelledby={`policy-${policy.franchiseSlug}`} class="mx-auto max-w-7xl px-6 py-16">
  <div class="rounded-[2rem] border border-amber-300/30 bg-amber-300/[0.07] p-7 md:p-10">
    <p class="text-sm font-black uppercase tracking-[0.22em] text-amber-200">Franchise standards</p>
    <h2 id={`policy-${policy.franchiseSlug}`} class="mt-3 text-3xl font-black text-white md:text-4xl">{policy.title}</h2>
    <div class="mt-5 flex flex-wrap gap-3 text-sm font-bold">
      <span class="rounded-full border border-amber-200/30 bg-slate-950/50 px-4 py-2 text-amber-100">{statusLabels[policy.verification]}</span>
      <span class="rounded-full border border-white/10 bg-slate-950/50 px-4 py-2 text-slate-300">Reviewed {policy.lastReviewed}</span>
    </div>
    <p class="mt-5 max-w-4xl leading-7 text-slate-300">{policy.source}</p>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {policy.items.map((item) => (
        <article class="rounded-3xl border border-white/10 bg-slate-950/70 p-6">
          <p class="text-xs font-black uppercase tracking-[0.2em] text-amber-200">{item.scope.replaceAll('-', ' ')}</p>
          <h3 class="mt-3 text-xl font-black text-white">{item.requirement}</h3>
          {item.explanation && <p class="mt-3 leading-7 text-slate-300">{item.explanation}</p>}
          <p class="mt-4 text-sm font-bold text-slate-400">{roleLabels[item.baronsRole]}</p>
        </article>
      ))}
    </div>
  </div>
</section>
