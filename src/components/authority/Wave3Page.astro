---
import type { Wave3Entity } from '../../data/authority/wave3';
import type { FranchisePolicy } from '../../data/authority/policies';
import PageHero from '../sections/PageHero.astro';
import ProductCta from '../commerce/ProductCta.astro';
import PolicySummary from './PolicySummary.astro';
import RelatedContent from './RelatedContent.astro';

interface Props {
  entity: Wave3Entity;
  policy?: FranchisePolicy;
}

const { entity, policy } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': entity.schemaType,
  name: entity.title,
  description: entity.description,
  provider: { '@type': 'Organization', name: "Barons, Inc." },
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<PageHero eyebrow={entity.eyebrow} title={entity.title} description={entity.description} />

<section class="mx-auto max-w-7xl px-6 pb-10">
  <div class="rounded-[2rem] bg-green-300 p-6 text-slate-950 md:p-8">
    <ProductCta entity={entity} />
  </div>
</section>

<section aria-labelledby="chaos-heading" class="mx-auto grid max-w-7xl gap-10 px-6 py-16 lg:grid-cols-[0.8fr_1.2fr]">
  <div>
    <p class="text-sm font-black uppercase tracking-[0.22em] text-green-300">How this reduces chaos</p>
    <h2 id="chaos-heading" class="mt-3 text-3xl font-black text-white md:text-4xl">{entity.promise}</h2>
    <p class="mt-5 leading-8 text-slate-300">{entity.chaosStatement}</p>
  </div>
  <div class="grid gap-4 md:grid-cols-2">
    {entity.highlights.map((item) => (
      <div class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">
        <p class="font-bold leading-7 text-slate-200">{item}</p>
      </div>
    ))}
  </div>
</section>

{policy && <PolicySummary policy={policy} />}

<section aria-labelledby="guidance-heading" class="border-y border-white/10 bg-white/[0.025]">
  <div class="mx-auto grid max-w-7xl gap-10 px-6 py-20 lg:grid-cols-2">
    <div>
      <p class="text-sm font-black uppercase tracking-[0.22em] text-amber-200">Common mistakes</p>
      <h2 id="guidance-heading" class="mt-3 text-3xl font-black text-white">What creates avoidable problems</h2>
      <ul class="mt-7 grid gap-4">
        {entity.commonMistakes.map((item) => <li class="rounded-2xl border border-white/10 bg-slate-950/70 p-5 leading-7 text-slate-300">{item}</li>)}
      </ul>
    </div>
    <div>
      <p class="text-sm font-black uppercase tracking-[0.22em] text-green-300">Barons guidance</p>
      <h2 class="mt-3 text-3xl font-black text-white">Build the system deliberately</h2>
      <ol class="mt-7 grid gap-4">
        {entity.guidance.map((item, index) => (
          <li class="grid grid-cols-[2.5rem_1fr] gap-4 rounded-2xl border border-white/10 bg-slate-950/70 p-5">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-green-300 font-black text-slate-950">{index + 1}</span>
            <p class="self-center leading-7 text-slate-300">{item}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<section aria-labelledby="questions-heading" class="mx-auto max-w-5xl px-6 py-20">
  <p class="text-sm font-black uppercase tracking-[0.22em] text-green-300">Questions people ask</p>
  <h2 id="questions-heading" class="mt-3 text-3xl font-black text-white md:text-4xl">Clear answers before the next step</h2>
  <div class="mt-8 grid gap-4">
    {entity.questions.map((item) => (
      <article class="rounded-3xl border border-white/10 bg-white/[0.03] p-6 md:p-7">
        <h3 class="text-xl font-black text-white">{item.question}</h3>
        <p class="mt-3 leading-8 text-slate-300">{item.answer}</p>
      </article>
    ))}
  </div>
</section>

<RelatedContent entity={entity} />

<p class="mx-auto max-w-7xl px-6 pb-20 text-sm text-slate-500">Content reviewed {entity.lastReviewed}.</p>
