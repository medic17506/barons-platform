---
import type { AuthorityEntity } from '../../types/authority';

interface Props {
  entity: AuthorityEntity;
}

const { entity } = Astro.props;

const titleCase = (slug: string) => slug
  .split('-')
  .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
  .join(' ');

const groups = [
  { label: 'Related solutions', base: '/solutions', items: entity.relatedSolutions ?? [] },
  { label: 'Related platforms', base: '/platforms', items: entity.relatedPlatforms ?? [] },
  { label: 'Industry context', base: '/industries', items: entity.relatedIndustries ?? [] },
  { label: 'Franchise context', base: '/franchises', items: entity.relatedFranchises ?? [] },
  { label: 'Local context', base: '/locations', items: entity.relatedLocations ?? [] },
  { label: 'Helpful resources', base: '/resources', items: entity.relatedResources ?? [] },
].filter((group) => group.items.length > 0);
---

{groups.length > 0 && (
  <section aria-labelledby={`related-${entity.slug}`} class="mx-auto max-w-7xl px-6 pb-20">
    <p class="text-sm font-black uppercase tracking-[0.22em] text-green-300">Connected knowledge</p>
    <h2 id={`related-${entity.slug}`} class="mt-3 text-3xl font-black text-white md:text-4xl">Explore the parts of the operating system that connect to this decision.</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {groups.map((group) => (
        <article class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">
          <h3 class="text-xl font-black text-white">{group.label}</h3>
          <ul class="mt-5 grid gap-3">
            {group.items.map((slug) => (
              <li>
                <a class="font-bold text-green-300 underline decoration-green-300/30 underline-offset-4 hover:text-green-200" href={`${group.base}/${slug}`}>
                  {titleCase(slug)}
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>
)}
