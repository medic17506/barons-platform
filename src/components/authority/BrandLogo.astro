---
import type { BrandAsset } from '../../types/authority';

interface Props {
  brand: string;
  asset?: BrandAsset;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { brand, asset, size = 'md', class: className = '' } = Astro.props;
const sizes = {
  sm: 'h-10 min-w-10 px-3',
  md: 'h-16 min-w-16 px-4',
  lg: 'h-24 min-w-24 px-6',
};
const initials = brand
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word[0])
  .join('')
  .toUpperCase();
const canRenderAsset = Boolean(asset?.src && asset.approved !== false);
---

<div class:list={['inline-flex items-center justify-center rounded-2xl border border-white/10 bg-white p-2 shadow-sm', sizes[size], className]}>
  {canRenderAsset ? (
    <img
      src={asset!.src}
      alt={asset!.alt}
      width={asset!.width}
      height={asset!.height}
      loading="lazy"
      decoding="async"
      class="max-h-full max-w-full object-contain"
    />
  ) : (
    <span aria-label={`${brand} logo placeholder`} class="font-black tracking-tight text-slate-800">{initials}</span>
  )}
</div>
