---
import { footerNavigation, navigation } from '../../data/navigation';
import { platforms } from '../../data/solutions';
import { site } from '../../config/site';
const links = [...navigation, ...footerNavigation];
---
<footer class="border-t border-white/10 bg-slate-950">
  <div class="mx-auto max-w-7xl px-6 py-14">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr_0.8fr]">
      <div>
        <img src={site.logo} alt="Barons, Inc." class="h-12 w-auto" />
        <p class="mt-5 max-w-md text-sm leading-7 text-slate-400">{site.description}</p>
        <p class="mt-5 text-xs font-bold uppercase tracking-[0.22em] text-green-300">Human-first. Platform-aware. Problem-first.</p>
      </div>
      <div>
        <h2 class="text-sm font-black uppercase tracking-[0.24em] text-slate-500">Explore</h2>
        <div class="mt-5 grid grid-cols-2 gap-3">
          {links.map((link) => <a class="text-sm font-semibold text-slate-300 hover:text-green-300" href={link.href}>{link.title}</a>)}
        </div>
      </div>
      <div>
        <h2 class="text-sm font-black uppercase tracking-[0.24em] text-slate-500">Platforms</h2>
        <div class="mt-5 flex flex-wrap gap-2">
          {platforms.slice(0, 10).map((platform) => <span class="rounded-full border border-white/10 px-3 py-1 text-xs font-semibold text-slate-400">{platform}</span>)}
        </div>
      </div>
    </div>
    <div class="mt-12 flex flex-col gap-3 border-t border-white/10 pt-6 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between">
      <p>{site.copyright}</p>
      <p>Built for speed, SEO, GEO, and people who still answer the phone.</p>
    </div>
  </div>
</footer>
