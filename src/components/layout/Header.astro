---
import { navigation } from '../../data/navigation';
import { site } from '../../config/site';
---
<header class="fixed inset-x-0 top-0 z-40 border-b border-white/10 bg-slate-950/82 backdrop-blur-xl">
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between gap-6 px-6">
    <a href="/" class="flex items-center gap-3" aria-label="Barons home">
      <img src={site.logo} alt="Barons, Inc." class="h-10 w-auto" />
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary navigation">
      {navigation.map((item) => (
        <a href={item.href} class="text-sm font-bold text-slate-300 transition hover:text-green-300">{item.title}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href="/contact" class="hidden rounded-full border border-green-300/30 bg-green-300/10 px-5 py-2.5 text-sm font-black text-green-200 transition hover:bg-green-300 hover:text-slate-950 sm:inline-flex">
        Talk to a human
      </a>
      <a href="/contact" class="inline-flex rounded-full bg-green-400 px-4 py-2.5 text-sm font-black text-slate-950 lg:hidden">Contact</a>
    </div>
  </div>
</header>
