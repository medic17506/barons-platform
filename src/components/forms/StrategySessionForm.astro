---
const formUrl = 'https://forms.zohopublic.com/baronsinc1/form/LeadFormScheduleaStrategySession/formperma/vvKZ0GZ-QQjYsYlk03suO6OQvNzMwS4T5AYyVTbLUic';
---

<section aria-labelledby="strategy-form-heading" class="rounded-[2rem] border border-white/10 bg-slate-900/70 p-4 shadow-2xl shadow-green-950/20 md:p-8">
  <div class="mb-7 max-w-3xl">
    <p class="text-sm font-black uppercase tracking-[0.22em] text-green-300">Human-guided strategy</p>
    <h2 id="strategy-form-heading" class="mt-3 text-3xl font-black tracking-tight text-white md:text-4xl">Tell us where the business feels stuck.</h2>
    <p class="mt-4 leading-7 text-slate-300">This takes about two to three minutes. Your answers help us spend the strategy session solving problems instead of collecting information you already provided.</p>
  </div>

  <ul class="mb-7 grid gap-3 text-sm text-slate-200 sm:grid-cols-2 lg:grid-cols-4" aria-label="Strategy session commitments">
    {['No high-pressure sales', 'Honest recommendations', '24 years of experience', 'Clear next steps'].map((item) => (
      <li class="flex items-center gap-2 rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3">
        <span class="text-green-300" aria-hidden="true">✓</span>
        <span>{item}</span>
      </li>
    ))}
  </ul>

  <div class="overflow-hidden rounded-2xl border border-white/10 bg-white">
    <iframe
      id="ziframe_strategy_session"
      title="Schedule Your Strategy Session with Barons"
      aria-label="Schedule Your Strategy Session"
      class="block min-h-[1100px] w-full border-0"
      src={formUrl}
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
    ></iframe>
  </div>

  <p class="mt-4 text-sm text-slate-400">
    Having trouble with the embedded form?
    <a class="font-bold text-green-300 underline decoration-green-300/50 underline-offset-4 hover:text-green-200" href="https://zfrmz.com/DXlQnld9dOpzePYa4S0M" target="_blank" rel="noopener noreferrer">Open the Strategy Session form in a new tab</a>.
  </p>
</section>

<script is:inline>
  (() => {
    try {
      const frame = document.getElementById('ziframe_strategy_session');
      if (!(frame instanceof HTMLIFrameElement)) return;

      const url = new URL(frame.src);
      if (!url.searchParams.has('referrername')) {
        let referrer = window.location.href;
        try {
          referrer = window.self !== window.top ? window.top.location.href : window.location.href;
        } catch {}
        if (referrer) {
          url.searchParams.set('referrername', referrer.slice(0, 1800));
          frame.src = url.toString();
        }
      }
    } catch {}
  })();
</script>
