---
const formUrl = 'https://forms.zohopublic.com/baronsinc1/form/ContactUs/formperma/VEEZlxOLa1tSQN8ijb2SUDF_XcFTsyaLFsLexsc9XCk';
---

<section aria-labelledby="contact-form-heading" class="rounded-[2rem] border border-white/10 bg-slate-900/70 p-4 shadow-2xl shadow-green-950/20 md:p-8">
  <div class="mb-7 max-w-3xl">
    <p class="text-sm font-black uppercase tracking-[0.22em] text-green-300">The front door to Barons</p>
    <h2 id="contact-form-heading" class="mt-3 text-3xl font-black tracking-tight text-white md:text-4xl">How can we help today?</h2>
    <p class="mt-4 leading-7 text-slate-300">Choose the reason for your message and tell us what you need. Your inquiry will be routed to the right member of our team.</p>
  </div>

  <div class="overflow-hidden rounded-2xl border border-white/10 bg-white">
    <iframe
      id="ziframe_contact"
      title="Contact Barons — How Can We Help?"
      aria-label="How Can We Help?"
      class="block min-h-[1050px] w-full border-0"
      src={formUrl}
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
    ></iframe>
  </div>

  <p class="mt-4 text-sm text-slate-400">
    Having trouble with the embedded form?
    <a class="font-bold text-green-300 underline decoration-green-300/50 underline-offset-4 hover:text-green-200" href={formUrl} target="_blank" rel="noopener noreferrer">Open the Contact Barons form in a new tab</a>.
  </p>
</section>

<script is:inline>
  (() => {
    try {
      const frame = document.getElementById('ziframe_contact');
      if (!(frame instanceof HTMLIFrameElement)) return;

      const url = new URL(frame.src);
      if (!url.searchParams.has('referrername')) {
        let referrer = window.location.href;
        try {
          referrer = window.self !== window.top ? window.top.location.href : window.location.href;
        } catch {}

        if (referrer) {
          const queryIndex = referrer.indexOf('?');
          if (referrer.length > 1800 && queryIndex > -1) {
            referrer = referrer.slice(0, queryIndex);
          }
          url.searchParams.set('referrername', referrer.slice(0, 1800));
          frame.src = url.toString();
        }
      }
    } catch {}
  })();
</script>
