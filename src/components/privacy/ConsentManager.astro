---
const analytics = {
  ga4: import.meta.env.PUBLIC_GA4_ID ?? 'G-PHBN4D5VPZ',
  clarity: import.meta.env.PUBLIC_CLARITY_ID ?? 'xng30eelzm',
};

const marketing = {
  metaPixel: import.meta.env.PUBLIC_META_PIXEL_ID ?? '311282092739323',
  linkedInPartner: import.meta.env.PUBLIC_LINKEDIN_PARTNER_ID ?? '506684255',
};
---

<div
  id="consent-manager"
  data-ga4={analytics.ga4}
  data-clarity={analytics.clarity}
  data-meta-pixel={marketing.metaPixel}
  data-linkedin-partner={marketing.linkedInPartner}
>
  <div id="consent-banner" class="fixed inset-x-4 bottom-4 z-[100] hidden max-w-3xl rounded-3xl border border-white/15 bg-slate-900 p-6 shadow-2xl shadow-black/50 sm:left-auto sm:right-6" role="dialog" aria-modal="true" aria-labelledby="consent-title" aria-describedby="consent-description">
    <h2 id="consent-title" class="text-xl font-black text-white">Your privacy choices</h2>
    <p id="consent-description" class="mt-3 max-w-2xl text-sm leading-6 text-slate-300">We use essential technology to operate this website. With your permission, analytics help us improve the experience and marketing tools help us measure campaigns and reach interested visitors again. Choosing “Essential only” will not limit access to the site.</p>
    <div class="mt-5 flex flex-wrap gap-3">
      <button type="button" data-consent="all" class="min-h-12 rounded-full bg-green-300 px-5 py-3 font-black text-slate-950 hover:bg-green-200">Allow analytics and marketing</button>
      <button type="button" data-consent="analytics" class="min-h-12 rounded-full border border-white/20 px-5 py-3 font-black text-white hover:border-green-300 hover:text-green-300">Analytics only</button>
      <button type="button" data-consent="essential" class="min-h-12 rounded-full border border-white/20 px-5 py-3 font-black text-white hover:border-green-300 hover:text-green-300">Essential only</button>
    </div>
    <p class="mt-4 text-xs text-slate-400">Read our <a href="/privacy/" class="font-bold text-green-300 underline underline-offset-4">privacy notice</a>.</p>
  </div>

  <div id="consent-status" class="sr-only" aria-live="polite"></div>
</div>

<script is:inline>
  (() => {
    const STORAGE_KEY = 'barons-privacy-consent-v1';
    const manager = document.getElementById('consent-manager');
    const banner = document.getElementById('consent-banner');
    const status = document.getElementById('consent-status');
    if (!(manager instanceof HTMLElement) || !(banner instanceof HTMLElement)) return;

    const loadScript = (src, id) => {
      if (!src || document.getElementById(id)) return;
      const script = document.createElement('script');
      script.id = id;
      script.src = src;
      script.async = true;
      document.head.appendChild(script);
    };

    const loadAnalytics = () => {
      const ga4 = manager.dataset.ga4;
      if (ga4 && !window.dataLayer) {
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', ga4, { anonymize_ip: true });
        loadScript(`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(ga4)}`, 'barons-ga4');
      }

      const clarity = manager.dataset.clarity;
      if (clarity && !window.clarity) {
        window.clarity = function () { (window.clarity.q = window.clarity.q || []).push(arguments); };
        const script = document.createElement('script');
        script.id = 'barons-clarity';
        script.async = true;
        script.src = `https://www.clarity.ms/tag/${encodeURIComponent(clarity)}`;
        document.head.appendChild(script);
      }
    };

    const loadMarketing = () => {
      const metaPixel = manager.dataset.metaPixel;
      if (metaPixel && !window.fbq) {
        const fbq = function () { fbq.callMethod ? fbq.callMethod.apply(fbq, arguments) : fbq.queue.push(arguments); };
        fbq.push = fbq;
        fbq.loaded = true;
        fbq.version = '2.0';
        fbq.queue = [];
        window.fbq = fbq;
        loadScript('https://connect.facebook.net/en_US/fbevents.js', 'barons-meta-pixel');
        fbq('init', metaPixel);
        fbq('track', 'PageView');
      }

      const partnerId = manager.dataset.linkedinPartner;
      if (partnerId && !document.getElementById('barons-linkedin-insight')) {
        window._linkedin_partner_id = partnerId;
        window._linkedin_data_partner_ids = window._linkedin_data_partner_ids || [];
        window._linkedin_data_partner_ids.push(partnerId);
        loadScript('https://snap.licdn.com/li.lms-analytics/insight.min.js', 'barons-linkedin-insight');
      }
    };

    const applyConsent = (choice) => {
      if (choice === 'analytics' || choice === 'all') loadAnalytics();
      if (choice === 'all') loadMarketing();
      banner.classList.add('hidden');
      if (status) status.textContent = `Privacy preference saved: ${choice}.`;
      document.dispatchEvent(new CustomEvent('barons:consent', { detail: { choice } }));
    };

    const saveChoice = (choice) => {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({ choice, savedAt: new Date().toISOString() }));
      } catch {}
      applyConsent(choice);
    };

    banner.querySelectorAll('[data-consent]').forEach((button) => {
      button.addEventListener('click', () => saveChoice(button.getAttribute('data-consent') || 'essential'));
    });

    document.getElementById('privacy-choices')?.addEventListener('click', () => {
      banner.classList.remove('hidden');
      banner.querySelector('button')?.focus();
    });

    let savedChoice = '';
    try {
      savedChoice = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}').choice || '';
    } catch {}

    if (savedChoice) applyConsent(savedChoice);
    else banner.classList.remove('hidden');
  })();
</script>
