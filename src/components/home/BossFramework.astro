---
import Eyebrow from '../ui/Eyebrow.astro';
import ButtonLink from '../ui/ButtonLink.astro';
import { bossPhases } from '../../data/solutions';
---

<section aria-labelledby="boss-heading" class="border-y border-white/10 bg-slate-900/50 py-24">
  <div class="mx-auto max-w-7xl px-6">
    <div class="max-w-5xl">
      <Eyebrow text="The BOSS Framework" />

      <h2 id="boss-heading" class="mt-5 text-5xl font-black tracking-tight text-white md:text-7xl">
        The <span class="text-green-300">BOSS</span> Framework
      </h2>

      <p class="mt-5 max-w-3xl text-3xl font-black tracking-tight text-white md:text-5xl">
        A deliberate path from messy to scalable.
      </p>

      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-300">
        BOSS is the Barons Operating System for Scaling. It gives every project a clear structure before anyone starts throwing software at the problem.
      </p>

      <div class="mt-8">
        <ButtonLink href="/boss-framework" variant="secondary">Explore the framework</ButtonLink>
      </div>
    </div>

    <div class="mt-14 grid grid-cols-4 gap-3 sm:gap-5" aria-label="BOSS stands for Baseline, Optimize, Scale, and Support">
      {bossPhases.map((phase) => (
        <div class="text-center">
          <div class="text-5xl font-black leading-none text-green-300 sm:text-7xl lg:text-8xl" aria-hidden="true">{phase.phase}</div>
          <div class="mx-auto mt-3 h-1 w-10 rounded-full bg-green-400 sm:w-14" aria-hidden="true"></div>
          <p class="mt-3 text-xs font-black uppercase tracking-wide text-white sm:text-sm md:text-base">{phase.title}</p>
        </div>
      ))}
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {bossPhases.map((phase) => (
        <article class="rounded-3xl border border-white/10 bg-slate-950 p-6">
          <h3 class="text-xl font-black text-white">{phase.title}</h3>
          <p class="mt-3 leading-7 text-slate-300">{phase.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
