---
import ButtonLink from '../ui/ButtonLink.astro';
import Eyebrow from '../ui/Eyebrow.astro';
---
<section id="hero" aria-labelledby="hero-heading" class="relative isolate overflow-hidden border-b border-white/10 pt-28">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top_left,rgba(34,197,94,0.22),transparent_34%),radial-gradient(circle_at_78%_18%,rgba(14,165,233,0.18),transparent_30%),linear-gradient(180deg,#020617,#0f172a_58%,#020617)]"></div>
  <div class="absolute left-1/2 top-24 -z-10 h-72 w-72 -translate-x-1/2 rounded-full bg-green-300/10 blur-3xl"></div>

  <div class="mx-auto grid min-h-[780px] max-w-7xl items-center gap-12 px-6 py-20 lg:grid-cols-[1.05fr_0.95fr]">
    <div>
      <Eyebrow text="Barons Platform" />
      <h1 id="hero-heading" class="mt-5 max-w-5xl text-5xl font-black tracking-tight text-white md:text-7xl">
        Digitally evolve your business without losing the humans.
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-300">
        Barons builds connected business systems for accounting, payroll, payments, CRM, reporting, automation, and franchise operations. We bring the tools together, then stay close enough to make sure real people can use them.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <ButtonLink href="/contact">Start a Systems Conversation</ButtonLink>
        <ButtonLink href="/digievolve-quest" variant="secondary">Enter the DigiEvolve Quest</ButtonLink>
      </div>
      <div class="mt-10 grid max-w-2xl gap-4 sm:grid-cols-3">
        <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-4">
          <p class="text-3xl font-black text-green-300">23+</p>
          <p class="mt-1 text-xs uppercase tracking-[0.2em] text-slate-400">Years helping businesses</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-4">
          <p class="text-3xl font-black text-green-300">42+</p>
          <p class="mt-1 text-xs uppercase tracking-[0.2em] text-slate-400">Franchise ecosystems</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-4">
          <p class="text-3xl font-black text-green-300">9</p>
          <p class="mt-1 text-xs uppercase tracking-[0.2em] text-slate-400">Countries served</p>
        </div>
      </div>
    </div>

    <div>
      <div class="rounded-[2rem] border border-white/10 bg-slate-900/80 p-5 shadow-2xl shadow-green-950/20 backdrop-blur">
        <div class="rounded-[1.5rem] border border-white/10 bg-slate-950 p-6">
          <div class="flex flex-col gap-4 border-b border-white/10 pb-5 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="text-sm font-bold text-white">System Evolution Map</p>
              <p class="text-xs text-slate-500">DigiEvolve quest log</p>
            </div>
            <div class="flex flex-wrap gap-2">
              <span class="rounded-full border border-green-300/20 bg-green-300/10 px-3 py-1 text-xs font-black text-green-200">Quest status: active</span>
              <span class="rounded-full bg-green-400/10 px-3 py-1 text-xs font-bold text-green-300">Human guided</span>
            </div>
          </div>
          <div class="mt-6 grid gap-4">
            {['Accounting core stabilized', 'Payroll + workforce connected', 'Payments + cash flow clarified', 'CRM + onboarding mapped', 'Reporting + automation leveled up'].map((item, index) => (
              <div class="group flex items-center gap-4 rounded-2xl border border-white/10 bg-white/[0.03] p-4 transition hover:border-green-300/40 hover:bg-white/[0.06]">
                <span class="flex h-9 w-9 items-center justify-center rounded-full bg-green-400/10 text-sm font-black text-green-300">{index + 1}</span>
                <span class="font-semibold text-slate-200">{item}</span>
              </div>
            ))}
          </div>
          <div class="mt-6 rounded-2xl bg-green-400 p-5 text-slate-950">
            <p class="text-sm font-black uppercase tracking-[0.2em]">Next evolution</p>
            <p class="mt-2 text-lg font-black">A cleaner operating system for the business you are becoming.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>