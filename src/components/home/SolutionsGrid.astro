---
import Eyebrow from '../ui/Eyebrow.astro';
import ButtonLink from '../ui/ButtonLink.astro';
import { solutions } from '../../data/solutions';
---
<section class="bg-slate-950 py-24">
  <div class="mx-auto max-w-7xl px-6">
    <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
      <div>
        <Eyebrow text="What we build" />
        <h2 class="mt-4 max-w-3xl text-4xl font-black tracking-tight md:text-5xl">One connected business system, not another pile of software.</h2>
      </div>
      <ButtonLink href="/solutions" variant="secondary">View all solutions</ButtonLink>
    </div>
    <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {solutions.map((solution) => (
        <a href={`/solutions/${solution.slug}`} class="group rounded-3xl border border-white/10 bg-white/[0.03] p-6 transition hover:-translate-y-1 hover:border-green-300/50 hover:bg-white/[0.06]">
          <h3 class="text-xl font-black text-white">{solution.title}</h3>
          <p class="mt-4 leading-7 text-slate-400">{solution.description}</p>
          <p class="mt-6 text-sm font-bold text-green-300 group-hover:text-green-200">Explore →</p>
        </a>
      ))}
    </div>
  </div>
</section>
