---
interface Props {
  href: string;
  eyebrow: string;
  title: string;
  description: string;
  meta?: string;
}

const { href, eyebrow, title, description, meta } = Astro.props;
---

<article class="group flex h-full flex-col rounded-3xl border border-white/10 bg-white/[0.03] p-7 transition hover:border-green-300/40 hover:bg-white/[0.05]">
  <p class="text-xs font-black uppercase tracking-[0.2em] text-green-300">{eyebrow}</p>
  <h2 class="mt-4 text-2xl font-black text-white">
    <a class="focus:outline-none focus-visible:ring-2 focus-visible:ring-green-300 focus-visible:ring-offset-4 focus-visible:ring-offset-slate-950" href={href}>
      <span class="absolute inset-0"></span>
      {title}
    </a>
  </h2>
  <p class="mt-4 flex-1 leading-7 text-slate-300">{description}</p>
  {meta && <p class="mt-6 text-sm font-bold text-slate-500">{meta}</p>}
  <p class="mt-6 font-black text-green-300" aria-hidden="true">Read resource →</p>
</article>

<style>
  article { position: relative; }
</style>