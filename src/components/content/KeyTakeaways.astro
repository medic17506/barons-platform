---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <section aria-labelledby="key-takeaways-heading" class="rounded-3xl border border-green-300/20 bg-green-300/5 p-7 md:p-9">
    <p class="text-sm font-black uppercase tracking-[0.22em] text-green-300">The practical version</p>
    <h2 id="key-takeaways-heading" class="mt-3 text-3xl font-black tracking-tight text-white">Key takeaways</h2>
    <ul class="mt-6 grid gap-4 md:grid-cols-2">
      {items.map((item) => (
        <li class="flex gap-3 leading-7 text-slate-200">
          <span class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-green-400 text-sm font-black text-slate-950" aria-hidden="true">✓</span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </section>
)}
