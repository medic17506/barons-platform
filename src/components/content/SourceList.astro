---
interface Source {
  label: string;
  sourceType: string;
  verificationStatus: string;
  url?: string;
  notes?: string;
}

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;
---

{sources.length > 0 && (
  <section aria-labelledby="sources-heading" class="border-t border-white/10 pt-10">
    <h2 id="sources-heading" class="text-2xl font-black text-white">Sources and evidence</h2>
    <p class="mt-3 max-w-3xl leading-7 text-slate-400">These sources support the material claims in this resource. Barons experience and professional judgment are identified separately from external requirements.</p>
    <ul class="mt-6 grid gap-4">
      {sources.map((source) => (
        <li class="rounded-2xl border border-white/10 bg-white/[0.03] p-5">
          <p class="font-bold text-slate-100">
            {source.url ? <a class="underline decoration-green-300/50 underline-offset-4 hover:text-green-300" href={source.url} rel="noopener noreferrer">{source.label}</a> : source.label}
          </p>
          <p class="mt-2 text-sm capitalize text-slate-500">{source.sourceType.replaceAll('-', ' ')} · {source.verificationStatus.replaceAll('-', ' ')}</p>
          {source.notes && <p class="mt-3 text-sm leading-6 text-slate-400">{source.notes}</p>}
        </li>
      ))}
    </ul>
  </section>
)}
