---
const {
  eyebrow,
  title,
  description,
  align = 'center'
} = Astro.props;

const alignment =
  align === 'left'
    ? 'text-left items-start'
    : 'text-center items-center';
---

<div class={`mx-auto flex max-w-3xl flex-col gap-4 ${alignment}`}>
  {eyebrow && (
    <p class="text-sm font-semibold uppercase tracking-[0.24em] text-cyan-300">
      {eyebrow}
    </p>
  )}

  <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
    {title}
  </h2>

  {description && (
    <p class="text-base leading-8 text-slate-300 sm:text-lg">
      {description}
    </p>
  )}
</div>