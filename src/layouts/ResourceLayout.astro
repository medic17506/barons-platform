---
import Layout from './Layout.astro';
import ResourceMeta from '../components/content/ResourceMeta.astro';
import KeyTakeaways from '../components/content/KeyTakeaways.astro';
import SourceList from '../components/content/SourceList.astro';
import ButtonLink from '../components/ui/ButtonLink.astro';

const { data, canonical, headings = [] } = Astro.props;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': data.schemaType,
  headline: data.title,
  description: data.description,
  author: { '@type': 'Organization', name: data.author },
  publisher: { '@type': 'Organization', name: 'Barons, Inc.' },
  datePublished: data.publishedAt,
  dateModified: data.lastReviewed,
  mainEntityOfPage: canonical,
};
---

<Layout title={data.seoTitle} description={data.seoDescription} canonical={canonical} noindex={data.draft || data.status !== 'published'}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <main id="main-content">
    <header class="relative overflow-hidden border-b border-white/10 pt-28">
      <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top_left,rgba(34,197,94,0.18),transparent_35%),linear-gradient(180deg,#020617,#0f172a)]"></div>
      <div class="mx-auto max-w-5xl px-6 py-20">
        <p class="text-sm font-black uppercase tracking-[0.22em] text-green-300">{data.eyebrow}</p>
        <h1 class="mt-5 text-5xl font-black tracking-tight text-white md:text-7xl">{data.title}</h1>
        <p class="mt-7 max-w-3xl text-xl leading-9 text-slate-300">{data.description}</p>
        <div class="mt-10">
          <ResourceMeta author={data.author} lastReviewed={data.lastReviewed} verificationStatus={data.verificationStatus} type={data.type} />
        </div>
      </div>
    </header>

    <div class="mx-auto grid max-w-7xl gap-12 px-6 py-16 lg:grid-cols-[minmax(0,1fr)_18rem]">
      <article class="min-w-0">
        <KeyTakeaways items={data.keyTakeaways} />
        <div class="resource-prose mt-12 max-w-none">
          <slot />
        </div>
        <div class="mt-14">
          <SourceList sources={data.sources} />
        </div>
      </article>

      <aside class="lg:sticky lg:top-28 lg:self-start">
        {headings.length > 0 && (
          <nav aria-labelledby="on-this-page-heading" class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">
            <h2 id="on-this-page-heading" class="font-black text-white">On this page</h2>
            <ul class="mt-4 grid gap-3 text-sm">
              {headings.filter((heading: { depth: number }) => heading.depth === 2).map((heading: { slug: string; text: string }) => (
                <li><a class="text-slate-400 hover:text-green-300" href={`#${heading.slug}`}>{heading.text}</a></li>
              ))}
            </ul>
          </nav>
        )}
        <div class="mt-6 rounded-3xl bg-green-400 p-6 text-slate-950">
          <p class="text-sm font-black uppercase tracking-[0.18em]">Need help applying this?</p>
          <p class="mt-3 text-lg font-black">A real person can help you map the next step.</p>
          <div class="mt-5"><ButtonLink href="/start" variant="secondary">Start a Strategy Session</ButtonLink></div>
        </div>
      </aside>
    </div>
  </main>
</Layout>

<style is:global>
  .resource-prose h2 { margin-top: 3.5rem; font-size: clamp(1.875rem, 4vw, 2.5rem); font-weight: 900; letter-spacing: -0.025em; color: white; }
  .resource-prose h3 { margin-top: 2.5rem; font-size: 1.5rem; font-weight: 900; color: white; }
  .resource-prose p { margin-top: 1.25rem; max-width: 48rem; font-size: 1.0625rem; line-height: 1.9; color: rgb(203 213 225); }
  .resource-prose ul, .resource-prose ol { margin-top: 1.25rem; display: grid; max-width: 48rem; gap: 0.75rem; padding-left: 1.5rem; color: rgb(203 213 225); }
  .resource-prose ul { list-style: disc; }
  .resource-prose ol { list-style: decimal; }
  .resource-prose a { color: rgb(134 239 172); text-decoration: underline; text-underline-offset: 0.25rem; }
  .resource-prose strong { color: white; }
  .resource-prose blockquote { margin-top: 2rem; border-left: 4px solid rgb(74 222 128); padding-left: 1.5rem; font-size: 1.25rem; line-height: 1.8; color: rgb(226 232 240); }
</style>
